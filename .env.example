# ---- DataLens environment variables ----
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local. Values here are placeholders ONLY.

# ---------------------------------------------------------------------------
# Firebase Authentication
# Used for "Continue with Google" user authentication (Firebase Auth optional).
# These NEXT_PUBLIC_ values are safe to expose to the client per Firebase docs.
# https://console.firebase.google.com -> Project settings -> General
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placeholder
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=placeholder.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=placeholder
NEXT_PUBLIC_FIREBASE_APP_ID=placeholder

# ---------------------------------------------------------------------------
# Google Cloud Platform
# OAuth 2.0 Web client used for Google Drive / Google Sheets imports, and by
# gdrive-db (https://www.npmjs.com/package/gdrive-db) to sign in and treat a
# Drive folder as a live database (Sidebar "Drive database" panel in /workspace).
# https://console.cloud.google.com -> APIs & Services -> Credentials
# Create a "Web application" OAuth client, enable the Google Drive API, and
# add your dev/prod origins under "Authorized JavaScript origins".
# ---------------------------------------------------------------------------
# Client ID is embedded in the browser app (public by design).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com

# Client secret is SERVER-ONLY and must NEVER be prefixed with NEXT_PUBLIC_.
# Only required if a server-side token exchange flow is implemented.
GOOGLE_CLIENT_SECRET=placeholder

# Authorized JavaScript origin (local dev)
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# Maximum file upload size in bytes (default 100 MB = 104857600).
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=104857600

