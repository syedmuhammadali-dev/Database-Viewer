# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local
.env.development*
.env.production*
.phpunit.result.cache

# secrets / credentials (defense in depth)
*.pem
*.p12
*.pfx
serviceAccount*.json
service-account*.json
*-service-account.json
firebase-adminsdk*.json
.credentials/
credentials/

# local working task tracker (kept local only)
remaining-tasks.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated duckdb assets (copied from node_modules by prebuild/predev)
/public/duckdb/
remainig-tasks.md

# stray fixture files DuckDB-wasm's node test worker writes to real disk (tests/database.test.ts)
/export.parquet
/legacy.sqlite


.vercel
